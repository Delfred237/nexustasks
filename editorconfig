# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending all files
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Java / Maven (Backend)
[*.{java,xml}]
indent_style = space
indent_size = 4

# React / TypeScript / Vite (Frontend)
[*.{js,jsx,ts,tsx,json,css,scss,html,yml,yaml}]
indent_style = space
indent_size = 2

# Flutter / Dart (Mobile)
[*.dart]
indent_style = space
indent_size = 2

# Markdown (Docs)
[*.md]
trim_trailing_whitespace = false